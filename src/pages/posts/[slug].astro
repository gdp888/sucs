---
import Layout from '../../layouts/Layout.astro';
import { postsData as allPosts } from '../../data/postsData';

export function getStaticPaths() {
  return allPosts.map((post) => ({
    params: { slug: String(post.id) },
    props: { post: post }
  }));
}

const { post } = Astro.props;
const formattedDate = new Date(post.date).toLocaleDateString('ru-RU', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title={post.title}>
  <article class="max-w-3xl mx-auto px-4 py-8">
    <a href="/" class="inline-block mb-6 text-blue-600 hover:text-blue-800 transition-colors">
      ← Назад к новостям
    </a>
    
    <header class="mb-8">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{post.title}</h1>
      <time class="text-gray-500 text-sm">{formattedDate}</time>
    </header>
    
    {post.images && post.images.length > 0 && (
      <div class="mb-8">
        <img 
          src={post.images[0]} 
          alt={post.title}
          class="w-full h-auto rounded-lg shadow-md"
          loading="lazy"
        />
      </div>
    )}
    
    <div class="prose prose-lg max-w-none">
      <p class="text-gray-700 whitespace-pre-line leading-relaxed">{post.text}</p>
    </div>
    
    <footer class="mt-8 pt-6 border-t border-gray-200">
      <a 
        href={post.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center text-blue-600 hover:text-blue-800 transition-colors"
      >
        <span>Оригинал поста ВКонтакте</span>
        <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </footer>
  </article>
</Layout>
