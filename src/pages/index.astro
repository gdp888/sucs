---
import Layout from '../layouts/Layout.astro';

const posts = [
  {
    "id": "783",
    "title": "Наши достижения в спорте",
    "text": "Поздравляем наших воспитанников с новыми победами! Команда \"Достижение Дети\" заняла первое место в региональных соревнованиях по гимнастике. Благодарим тренеров за профессионализм и терпение!",
    "date": "2025-01-15T10:30:00Z",
    "images": ["https://sun1-14.vkuserphoto.ru/impg/RGew-yLOA-DsfqtmVDHK2LBPTSNOIu0BjJwBaA/Z0mx4sRjDcQ.jpg?size=720x480&quality=95"],
    "url": "https://vk.ru/wall-223846998_783"
  },
  {
    "id": "782",
    "title": "Открыт набор в секцию гимнастики",
    "text": "Приглашаем детей от 5 до 12 лет на занятия художественной гимнастикой! Первые две недели - пробные занятия бесплатно. Запись по телефону +7 (950) 313-81-50",
    "date": "2025-01-12T14:00:00Z",
    "images": [],
    "url": "https://vk.ru/wall-223846998_782"
  },
  {
    "id": "781",
    "title": "Праздничный концерт ко Дню защиты детей",
    "text": "Приглашаем всех на праздничный концерт наших воспитанников! Выступление состоится 1 июня в 15:00 в культурном центре города Новокуйбышевск.",
    "date": "2025-01-10T09:00:00Z",
    "images": [],
    "url": "https://vk.ru/wall-223846998_781"
  },
  {
    "id": "780",
    "title": "Тренировочный сбор в Москве",
    "text": "Наши спортсмены вернулись с учебно-тренировочного сбора в Москве. Ребята работали с ведущими тренерами страны и показали отличные результаты!",
    "date": "2025-01-08T16:45:00Z",
    "images": [],
    "url": "https://vk.ru/wall-223846998_780"
  },
  {
    "id": "779",
    "title": "Новое оборудование в зале",
    "text": "В нашем спортивном зале установлено новое современное оборудование для занятий гимнастикой. Теперь тренировки станут еще более эффективными и безопасными!",
    "date": "2025-01-05T11:20:00Z",
    "images": [],
    "url": "https://vk.ru/wall-223846998_779"
  },
  {
    "id": "778",
    "title": "Победа на областных соревнованиях",
    "text": "Поздравляем Анну Петрову с золотой медалью на областных соревнованиях по художественной гимнастике! Анна занимается в нашей секции уже 5 лет.",
    "date": "2025-01-03T13:15:00Z",
    "images": [],
    "url": "https://vk.ru/wall-223846998_778"
  },
  {
    "id": "777",
    "title": "Расписание занятий на январь",
    "text": "Опубликовано расписание занятий на январь 2025 года. Обратите внимание на изменения в графике работы в праздничные дни.",
    "date": "2025-01-01T10:00:00Z",
    "images": [],
    "url": "https://vk.ru/wall-223846998_777"
  },
  {
    "id": "776",
    "title": "С Новым годом!",
    "text": "Коллектив центра \"Достижение Дети\" поздравляет всех с наступающим Новым годом! Желаем здоровья, успехов и новых побед!",
    "date": "2024-12-31T18:00:00Z",
    "images": [],
    "url": "https://vk.ru/wall-223846998_776"
  },
  {
    "id": "775",
    "title": "Итоги года",
    "text": "Подводим итоги 2024 года: 15 золотых, 20 серебряных и 25 бронзовых медалей на различных соревнованиях. Спасибо всем тренерам, родителям и нашим талантливым детям!",
    "date": "2024-12-28T12:00:00Z",
    "images": [],
    "url": "https://vk.ru/wall-223846998_775"
  },
  {
    "id": "774",
    "title": "Родительское собрание",
    "text": "Уважаемые родители! 25 декабря в 19:00 состоится общее родительское собрание. Обсуждаем планы на 2025 год и организацию выездных сборов.",
    "date": "2024-12-25T09:30:00Z",
    "images": [],
    "url": "https://vk.ru/wall-223846998_774"
  }
];

function formatDate(dateString) {
  return new Date(dateString).toLocaleDateString('ru-RU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout title="Достижение Дети - Главная">
  <div class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Центр детского спорта "Достижение Дети"</h1>
        <p class="text-xl md:text-2xl opacity-90 mb-8">Художественная гимнастика и всестороннее развитие детей</p>
        <a href="#news" class="inline-block bg-white text-blue-600 px-8 py-3 rounded-full font-semibold hover:bg-gray-100 transition-colors">
          Наши новости
        </a>
      </div>
    </section>

    <!-- News Section -->
    <section id="news" class="py-12">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Последние новости</h2>
        
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map(post => (
            <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
              {post.images && post.images.length > 0 ? (
                <img 
                  src={post.images[0]} 
                  alt={post.title}
                  class="w-full h-48 object-cover"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-48 bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center">
                  <svg class="w-16 h-16 text-white opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                  </svg>
                </div>
              )}
              
              <div class="p-6">
                <time class="text-sm text-gray-500 mb-2 block">{formatDate(post.date)}</time>
                <h3 class="text-xl font-semibold text-gray-900 mb-3 line-clamp-2">{post.title}</h3>
                <p class="text-gray-600 mb-4 line-clamp-3">{post.text}</p>
                <a 
                  href={`/posts/${post.id}`}
                  class="inline-block text-blue-600 hover:text-blue-800 font-medium transition-colors"
                >
                  Читать далее →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-12 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Контакты</h2>
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <div>
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Телефон</h3>
            <p class="text-gray-600">+7 (950) 313-81-50</p>
          </div>
          <div>
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Адрес</h3>
            <p class="text-gray-600">г. Новокуйбышевск, ул. Мичурина, д. 11 А</p>
          </div>
          <div>
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.223-.548.223l.188-2.85 5.18-4.686c.223-.198-.054-.306-.346-.106l-6.4 4.02-2.76-.86c-.6-.19-.612-.6.125-.89l10.782-4.156c.5-.187.937.114.785.89z"/>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">ВКонтакте</h3>
            <a href="https://vk.ru/dostigenie_deti" target="_blank" class="text-blue-600 hover:text-blue-800">vk.ru/dostigenie_deti</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
