---
import Layout from '../layouts/Layout.astro';
import { postsData } from '../data/postsData';

const posts = postsData;

function formatDate(dateString) {
  return new Date(dateString).toLocaleDateString('ru-RU', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  });
}
---

<Layout title="Достижение Дети - Главная">
  <div class="min-h-screen bg-gray-50">
    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-blue-800 text-white py-16">
      <div class="max-w-6xl mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Центр детского спорта "Достижение Дети"</h1>
        <p class="text-xl md:text-2xl opacity-90 mb-8">Художественная гимнастика и всестороннее развитие детей</p>
        <a href="#news" class="inline-block bg-white text-blue-600 px-8 py-3 rounded-full font-semibold hover:bg-gray-100 transition-colors">
          Наши новости
        </a>
      </div>
    </section>

    <!-- News Section -->
    <section id="news" class="py-12">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Последние новости</h2>
        
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map(post => (
            <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
              {post.images && post.images.length > 0 ? (
                <img 
                  src={post.images[0]} 
                  alt={post.title}
                  class="w-full h-48 object-cover"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-48 bg-gradient-to-br from-blue-400 to-blue-600 flex items-center justify-center">
                  <svg class="w-16 h-16 text-white opacity-50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"></path>
                  </svg>
                </div>
              )}
              
              <div class="p-6">
                <time class="text-sm text-gray-500 mb-2 block">{formatDate(post.date)}</time>
                <h3 class="text-xl font-semibold text-gray-900 mb-3 line-clamp-2">{post.title}</h3>
                <p class="text-gray-600 mb-4 line-clamp-3">{post.text}</p>
                <a 
                  href={`/posts/${post.id}`}
                  class="inline-block text-blue-600 hover:text-blue-800 font-medium transition-colors"
                >
                  Читать далее →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="py-12 bg-white">
      <div class="max-w-6xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Контакты</h2>
        <div class="grid md:grid-cols-3 gap-8 text-center">
          <div>
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Телефон</h3>
            <p class="text-gray-600">+7 (950) 313-81-50</p>
          </div>
          <div>
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">Адрес</h3>
            <p class="text-gray-600">г. Новокуйбышевск, ул. Мичурина, д. 11 А</p>
          </div>
          <div>
            <div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.894 8.221l-1.97 9.28c-.145.658-.537.818-1.084.508l-3-2.21-1.446 1.394c-.14.18-.357.223-.548.223l.188-2.85 5.18-4.686c.223-.198-.054-.306-.346-.106l-6.4 4.02-2.76-.86c-.6-.19-.612-.6.125-.89l10.782-4.156c.5-.187.937.114.785.89z"/>
              </svg>
            </div>
            <h3 class="font-semibold text-gray-900 mb-2">ВКонтакте</h3>
            <a href="https://vk.ru/dostigenie_deti" target="_blank" class="text-blue-600 hover:text-blue-800">vk.ru/dostigenie_deti</a>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
